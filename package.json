{
  "name": "Astro-star",
  "type": "module",
  "version": "0.21.8",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "predev": "pnpm run generate:signature && tsx scripts/generate-git-timestamps.ts",
    "dev": "astro dev",
    "prebuild": "pnpm run generate:signature && tsx scripts/generate-git-timestamps.ts",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "pnpm check && pnpm format:check && pnpm build && pnpm run audit:content && pnpm run audit:assets && pnpm run audit:deps",
    "astro": "astro",
    "algolia:sync": "tsx scripts/sync-algolia-index.ts",
    "generate:signature": "tsx scripts/generate-signature-asset.ts",
    "audit:assets": "tsx scripts/audit-assets.ts",
    "audit:content": "tsx scripts/audit-content.ts",
    "audit:deps": "pnpm audit --registry=https://registry.npmjs.org --audit-level moderate",
    "migrate:content": "node scripts/migrate-legacy-content.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "config:extract": "tsx scripts/config-extract.mjs",
    "config:apply": "node scripts/config-apply.mjs"
  },
  "devDependencies": {
    "better-sqlite3": "^12.6.2",
    "bson": "^7.2.0",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "tar": "^7.5.22",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/node": "^11.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@rowanmanning/feed-parser": "^2.1.3",
    "@waline/client": "^3.15.2",
    "astro": "^7.1.3",
    "astro-auto-import": "^0.5.2",
    "astro-loader-bluesky-posts": "^1.2.5",
    "astro-loader-github-prs": "^2.0.1",
    "astro-robots-txt": "^1.0.0",
    "katex": "^0.16.10",
    "lucide-static": "^0.562.0",
    "rehype-katex": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "unified": "^11.0.5"
  }
}
