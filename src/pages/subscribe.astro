---
import ContentShell from "../components/layout/ContentShell.astro";
import { site } from "../config/site";
import {
  sendSubscriptionMessage,
  subscriptionLink,
} from "../server/subscriptions/notifications";
import { readSubscriptionBody } from "../server/subscriptions/request";
import { getSubscriptionSettings } from "../server/subscriptions/settings";
import { getSubscriptionStore } from "../server/subscriptions/store";
import "../style/pages/subscribe.css";

const settings = getSubscriptionSettings();
const enabled = settings.smtp || settings.bark || settings.telegram;
const store = enabled ? getSubscriptionStore() : undefined;
const token = Astro.url.searchParams.get("token");
const subscription = token ? store?.getSubscription(token) : undefined;
let notice =
  token && !subscription
    ? "This subscription link is invalid or has expired."
    : "";

Astro.response.headers.set("cache-control", "no-store");
Astro.response.headers.set("referrer-policy", "strict-origin");

if (Astro.request.method === "POST") {
  if (!store) return new Response(null, { status: 404 });
  if (
    Astro.request.headers.get("content-type")?.split(";")[0] !==
    "application/x-www-form-urlencoded"
  ) {
    return new Response(null, { status: 415 });
  }
  const body = await readSubscriptionBody(Astro.request, 4096);
  if (!body) return new Response(null, { status: 400 });

  const form = new URLSearchParams(body);
  const action = form.get("action");
  const formToken = form.get("token") ?? "";

  if (action === "confirm") {
    const confirmed = store.confirmSubscription(formToken);
    notice =
      confirmed || store.getSubscription(formToken)?.confirmed_at != null
        ? "Your subscription is active."
        : "This subscription link is invalid or has expired.";
  } else if (action === "unsubscribe") {
    store.unsubscribe(formToken);
    notice = "This subscription is no longer active.";
  } else if (action === "email" || action === "bark") {
    const destination = form.get("destination")?.trim() ?? "";
    const valid =
      action === "email"
        ? settings.smtp &&
          destination.length <= 254 &&
          /^[^\s@<>,;():"\\]+@(?:[a-z0-9-]+\.)+[a-z0-9-]+$/i.test(destination)
        : settings.bark && /^[a-z0-9_-]{10,128}$/i.test(destination);

    if (valid) {
      // Email domain names are case-insensitive. The local part is kept intact.
      const address =
        action === "email"
          ? destination.replace(
              /@([^@]+)$/,
              (_, domain: string) => `@${domain.toLowerCase()}`,
            )
          : destination;
      const request = store.requestConfirmation(action, address);
      if (request) {
        try {
          await sendSubscriptionMessage(settings, action, address, {
            title: request.confirmed
              ? `Manage your ${site.site.name} subscription`
              : `Confirm your ${site.site.name} subscription`,
            body: request.confirmed
              ? "Open the link to manage your subscription."
              : "Open the link and confirm within 24 hours to receive new publication notifications.",
            url: subscriptionLink(request.token),
          });
        } catch {
          console.warn(
            `Subscription confirmation could not be sent (${action}).`,
          );
        }
      }
      notice =
        action === "email"
          ? "Check your email for a subscription link."
          : "Check Bark for a subscription notification.";
    } else {
      notice =
        action === "email"
          ? "Enter a valid email address."
          : "Enter a valid Bark device key.";
    }
  } else {
    return new Response(null, { status: 400 });
  }
}

const showManagement = Boolean(subscription && Astro.request.method === "GET");
---

<ContentShell
  title={`Subscribe - ${site.site.name}`}
  description="Get notified when new content is published."
  canonicalUrl={new URL("/subscribe/", site.site.url).href}
  contentAriaLabel="Subscriptions"
  tocAriaLabel="RSS feed"
>
  <meta slot="head" name="robots" content="noindex" />
  <div class="subscription-page">
    <h1>Subscribe</h1>
    {notice && <p role="status">{notice}</p>}

    {
      showManagement && subscription ? (
        <form method="post" action="/subscribe/">
          <input type="hidden" name="token" value={subscription.token} />
          {subscription.confirmed_at == null ? (
            <>
              <p>Confirm to receive new publication notifications.</p>
              <button name="action" value="confirm">
                Confirm subscription
              </button>
            </>
          ) : (
            <>
              <p>
                Your {subscription.channel === "bark" ? "Bark" : "email"}{" "}
                subscription is active.
              </p>
              <button name="action" value="unsubscribe">
                Unsubscribe
              </button>
            </>
          )}
        </form>
      ) : (
        <>
          <p>
            {enabled
              ? "Get notified when new content is published."
              : "Follow new publications with your RSS reader."}
          </p>
          {settings.smtp && (
            <form method="post" action="/subscribe/">
              <label for="subscription-email">Email address</label>
              <input
                id="subscription-email"
                name="destination"
                type="email"
                autocomplete="email"
                required
                maxlength="254"
              />
              <button name="action" value="email">
                Send email link
              </button>
            </form>
          )}
          {settings.bark && (
            <form method="post" action="/subscribe/">
              <label for="subscription-bark">Bark device key</label>
              <input
                id="subscription-bark"
                name="destination"
                type="password"
                autocomplete="off"
                required
                minlength="10"
                maxlength="128"
              />
              <p>Copy the device key from your Bark push URL at api.day.app.</p>
              <button name="action" value="bark">
                Send Bark link
              </button>
            </form>
          )}
          {settings.telegram && (
            <p>
              <a
                href={`https://t.me/${settings.telegram.username}?start=subscribe`}
              >
                Open the Telegram bot
              </a>
              {" and press Start. Send /stop to unsubscribe."}
            </p>
          )}
        </>
      )
    }
    <p><a href="/rss.xml">RSS feed</a></p>
  </div>
</ContentShell>
