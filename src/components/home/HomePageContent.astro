---
import { CODETIME_TOKEN } from "astro:env/server";
import HomeLayout from "../../layouts/HomeLayout.astro";
import GitHeatmap from "./githeatmap.astro";
import Signature from "./signature.astro";
import FooterMeta from "../common/FooterMeta.astro";
import ArchiveActivityHeatmap from "../content/ArchiveActivityHeatmap.astro";
import AppPanelIcon from "../ui/icons/AppPanelIcon.astro";
import type { SocialLinkItem } from "../../types/social";
import { isCodeTimeConfigured } from "../../utils/codetime";
import { getSocialLink } from "../../utils/social";
import "../../style/components/home/profile.css";
import "../../style/components/home/latest-articles.css";
import "../../style/components/home/home-page-content.css";
import "../../style/pages/home-page-entrance.css";

interface ProfileData {
  avatarSrc: string;
  bio: string;
  intro: string;
}

interface LatestArticleItem {
  title: string;
  href: string;
  pubDateIso: string;
  createdAtIso: string;
  updatedAtIso: string;
  displayDate: string;
  year: string;
  timestamp: number;
}

interface LatestTimelineGroup {
  year: string;
  articles: LatestArticleItem[];
}

interface Props {
  siteStats: { articles: number; words: number };
  activityEntries: {
    date: string;
    dateLabel: string;
    href: string;
    title: string;
  }[];
  profile: ProfileData;
  ownerName: string;
  profileLinks: SocialLinkItem[];
  latestBlogTimelineGroups: LatestTimelineGroup[];
  latestNoteTimelineGroups: LatestTimelineGroup[];
}

const {
  siteStats,
  activityEntries,
  profile,
  ownerName,
  profileLinks,
  latestBlogTimelineGroups,
  latestNoteTimelineGroups,
} = Astro.props as Props;
const homeDescription = profile.intro.trim() || profile.bio.trim();
const introSentences = profile.intro
  .trim()
  .match(/^(.+?[.!?])(?:\s+|$)([\s\S]*)$/);
const introLead = introSentences?.[1] ?? profile.intro.trim();
const introDetail = introSentences?.[2]?.trim() ?? "";
const introName = ownerName.trim();
const introNameIndex = introName ? introLead.indexOf(introName) : -1;
const introLeadParts =
  introNameIndex >= 0
    ? [
        introLead.slice(0, introNameIndex),
        introName,
        introLead.slice(introNameIndex + introName.length),
      ]
    : [introLead];
const encodeCssUrl = (value: string) =>
  encodeURI(value).replace(
    /["'()\\]/g,
    (character) => `%${character.charCodeAt(0).toString(16).toUpperCase()}`,
  );
const avatarStyle = `--profile-avatar-image: url("${encodeCssUrl(profile.avatarSrc)}")`;
const codeTimeEnabled = isCodeTimeConfigured(CODETIME_TOKEN);
const githubActivityEnabled = Boolean(getSocialLink("github")?.handle?.trim());
const CodeTime = codeTimeEnabled
  ? (await import("./CodeTime.astro")).default
  : undefined;

function isExternalLink(href: string) {
  return /^https?:\/\//.test(href);
}
---

<HomeLayout
  title={ownerName}
  description={homeDescription || undefined}
  ogTitle={ownerName}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={profile.avatarSrc}
    fetchpriority="high"
    data-home-avatar-preload
  />
  <Signature slot="signature" />
  <section
    slot="profile"
    class="profile-card home-profile-sequence"
    aria-label="Profile section"
    data-home-entrance-enabled="true"
  >
    <div class="profile-identity">
      <span
        class="profile-avatar-wrap home-enter-item"
        data-codetime-status-root={codeTimeEnabled ? "" : undefined}
      >
        <span
          class="profile-avatar-orbit"
          data-orbit-side="back"
          aria-hidden="true"></span>
        <span
          class="profile-avatar"
          role="img"
          aria-label={ownerName}
          style={avatarStyle}
          data-home-profile-avatar></span>
        <span
          class="profile-avatar-orbit"
          data-orbit-side="front"
          aria-hidden="true"></span>
        {
          CodeTime && (
            <span
              class="profile-codetime-popover"
              aria-hidden="true"
              data-codetime-status-popover
              hidden
            >
              <img
                class="profile-codetime-status"
                alt=""
                width="380"
                height="116"
                decoding="async"
                fetchpriority="low"
                referrerpolicy="no-referrer"
                data-codetime-status
                data-codetime-status-src="/api/codetime-status.svg"
              />
            </span>
          )
        }
      </span>
      <div class="profile-copy home-enter-item">
        {
          introLead && (
            <div class="profile-bio">
              <h1 class="profile-intro-lead">
                {introLeadParts.map((part, index) =>
                  index === 1 ? (
                    <span class="profile-intro-name">{part}</span>
                  ) : (
                    part
                  ),
                )}
              </h1>
              {introDetail && (
                <Fragment>
                  {" "}
                  <span class="profile-intro-detail">{introDetail}</span>
                </Fragment>
              )}
            </div>
          )
        }
      </div>
    </div>
    {
      profile.bio.trim() && (
        <p class="profile-one-word profile-motto home-enter-item">
          <em>{profile.bio}</em>
        </p>
      )
    }
    <dl
      class="profile-site-stats home-enter-item"
      aria-label="Site statistics"
      data-home-site-stats
      data-article-paths={JSON.stringify(
        activityEntries.map((entry) => entry.href),
      )}
    >
      <div class="profile-site-stat">
        <dt>articles</dt>
        <dd>{siteStats.articles.toLocaleString("en-US")}</dd>
      </div>
      <div class="profile-site-stat">
        <dt>words</dt>
        <dd>{siteStats.words.toLocaleString("en-US")}</dd>
      </div>
      <div class="profile-site-stat">
        <dt>views</dt>
        <dd data-home-total-views>—</dd>
      </div>
      <div class="profile-site-stat">
        <dt>likes</dt>
        <dd data-home-total-likes>—</dd>
      </div>
    </dl>
    <div class="profile-connections">
      {
        profileLinks.length > 0 && (
          <nav class="profile-links" aria-label="Profile quick links">
            {profileLinks.map((item) => (
              <a
                class="profile-link home-enter-item"
                href={item.href}
                target={isExternalLink(item.href) ? "_blank" : undefined}
                rel={isExternalLink(item.href) ? "noreferrer" : undefined}
                aria-label={item.name}
                data-icon-hover
              >
                <AppPanelIcon name={item.icon} label={item.name} />
                <span class="profile-link-label" aria-hidden="true">
                  {item.name}
                </span>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </section>
  <section
    slot="latest"
    class="latest-articles home-latest-sequence"
    aria-label="Latest content section"
    data-home-entrance-enabled="true"
  >
    {
      activityEntries.length > 0 && (
        <section class="home-activity" aria-labelledby="home-articles-title">
          <h2 class="home-activity-title" id="home-articles-title">
            <span class="home-activity-title-text">Article Timeline</span>
          </h2>
          <div class="home-profile-metrics">
            <ArchiveActivityHeatmap
              entries={activityEntries}
              label="Blog, Note and Project"
              months={18}
              variant="orbit"
            />
          </div>
        </section>
      )
    }
    {
      [
        {
          key: "blogs",
          title: "Latest Blogs",
          archiveHref: "/blog/",
          archiveLabel: "View all blogs",
          archiveHint: "View all blogs",
          groups: latestBlogTimelineGroups,
        },
        {
          key: "notes",
          title: "Latest Notes",
          archiveHref: "/note/",
          archiveLabel: "View all notes",
          archiveHint: "View all notes",
          groups: latestNoteTimelineGroups,
        },
      ].map((block) => (
        <section
          class="latest-articles-panel"
          aria-label={block.title}
          data-latest-key={block.key}
        >
          <header class="latest-articles-heading">
            <h2 class="latest-articles-title">
              <a
                class="latest-articles-title-link"
                href={block.archiveHref}
                aria-label={block.archiveLabel}
                title={block.archiveLabel}
                data-astro-prefetch
              >
                <span class="latest-articles-title-text">{block.title}</span>
                <span class="latest-articles-title-hint">
                  {block.archiveHint}
                </span>
              </a>
            </h2>
          </header>
          {block.groups.length > 0 ? (
            <div
              class="latest-articles-groups"
              aria-label={`${block.title} timeline`}
            >
              {block.groups.map((group) => (
                <section
                  class="latest-articles-group"
                  aria-label={`${group.year} articles`}
                >
                  <h3 class="latest-articles-year-label">{group.year}</h3>
                  <ol
                    class="latest-articles-list"
                    aria-label={`${group.year} timeline`}
                  >
                    {group.articles.map((article, index) => (
                      <li
                        class:list={[
                          "latest-articles-item",
                          index === 0 && "latest-articles-item--year-start",
                          index === group.articles.length - 1 &&
                            "latest-articles-item--year-end",
                        ]}
                      >
                        <svg
                          class="latest-articles-orbit"
                          viewBox="0 0 32 100"
                          preserveAspectRatio="none"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path
                            d="M16 0 C16 24 9 26 9 50 C9 74 16 76 16 100"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="0.75"
                            vector-effect="non-scaling-stroke"
                          />
                        </svg>
                        <div class="latest-articles-item-content">
                          <time
                            class="latest-articles-time"
                            datetime={article.pubDateIso}
                          >
                            {article.displayDate}
                          </time>
                          <a
                            class="latest-articles-link"
                            href={article.href}
                            data-astro-prefetch
                          >
                            <span class="latest-articles-link-text">
                              {article.title}
                            </span>
                            <span
                              class="latest-articles-link-arrow"
                              aria-hidden="true"
                            />
                          </a>
                        </div>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          ) : (
            <p class="latest-articles-empty">No {block.key} published yet.</p>
          )}
        </section>
      ))
    }
    {
      CodeTime && (
        <div class="home-activity">
          <div
            class="home-profile-metric"
            data-codetime-metric
            data-codetime-state="waiting"
          >
            <CodeTime />
          </div>
        </div>
      )
    }
    {
      githubActivityEnabled && (
        <section class="home-activity" aria-labelledby="home-github-title">
          <h2 class="home-activity-title" id="home-github-title">
            <span class="home-activity-title-text">Github Heatmap</span>
          </h2>
          <div class="home-profile-metrics">
            <div class="home-profile-metric">
              <GitHeatmap />
            </div>
          </div>
        </section>
      )
    }
  </section>
  <FooterMeta slot="footer-info" />
</HomeLayout>
