---
import { site } from "../../config/site";
import {
  SIGNATURE_ASSET_BASENAME,
  isValidSignatureSvgMarkup,
  normalizeSignatureSvgMarkup,
} from "../../utils/signature-svg";
import "../../style/components/home/signature.css";

const profile = site.profile as {
  signatureSvg?: string;
};
const signatureSvg = profile.signatureSvg ?? "";
const signatureAssetSrc = `/${SIGNATURE_ASSET_BASENAME}`;

const svgMarkup = normalizeSignatureSvgMarkup(signatureSvg);
const hasSignatureAsset = isValidSignatureSvgMarkup(svgMarkup);
const signatureMaskStyle = hasSignatureAsset
  ? `--signature-mask: url("${signatureAssetSrc}");`
  : undefined;
---

{
  hasSignatureAsset && (
    <a class="signature-wrap" href="/" aria-label="Back to home">
      <span
        class="signature-mark"
        aria-hidden="true"
        data-signature-src="true"
        data-signature-asset={signatureAssetSrc}
        style={signatureMaskStyle}
      />
    </a>
  )
}
