---
import Icon from "../../components/ui/Icon.astro";
import GithubIcon from "../../components/ui/icons/GithubIcon.astro";
import RssIcon from "../../components/ui/icons/RssIcon.astro";
import FloatingActionButton from "../../components/ui/FloatingActionButton.astro";
import { isAlgoliaSiteSearchConfigured } from "../../config/search";
import {
  AlignLeft,
  ArrowUp,
  FolderKanban,
  Monitor,
  Moon,
  Search,
  Sun,
  TableOfContents,
} from "lucide-static";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  foldedNavItems: readonly NavItem[];
  githubHref?: string;
  initialHomeEntrance?: boolean;
  initialThemeMode?: "light" | "dark" | "system";
  shellStyle?: string;
  shellVariant?: "default" | "article";
}

const {
  foldedNavItems,
  githubHref = "",
  initialHomeEntrance = false,
  initialThemeMode = "system",
  shellStyle = "",
  shellVariant = "default",
} = Astro.props as Props;
const pathname = Astro.url.pathname;
---

<div
  class:list={[
    "home-shell",
    shellVariant !== "default" && `home-shell--${shellVariant}`,
  ]}
  style={shellStyle || undefined}
  data-home-initial-entrance={initialHomeEntrance ? "true" : undefined}
  data-home-shell-root
>
  <header class="home-header">
    <div class="home-header-inner">
      <span class="header-star-field" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
      </span>
      <div class="wire-box signature-area" aria-label="Signature area">
        <div class="signature-stack">
          <slot name="signature" />
        </div>
      </div>

      <nav class="desktop-top-nav" aria-label="Main navigation">
        <ul class="top-nav-links">
          {
            foldedNavItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={pathname === item.href ? "page" : undefined}
                  data-active={
                    pathname.startsWith(item.href) ? "true" : undefined
                  }
                  data-astro-prefetch
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <slot name="side-nav" />
      </nav>

      <div class="wire-box header-actions" aria-label="Actions area">
        <div class="theme-switcher" role="group" aria-label="Theme switcher">
          <button
            type="button"
            id="theme-toggle"
            class="theme-btn"
            aria-label="Theme switcher"
            data-icon-tooltip="Theme switcher"
            data-tooltip-placement="bottom"
            data-tooltip-align="end"
          >
            <span data-theme-icon="light" hidden={initialThemeMode !== "light"}
              ><Icon svg={Sun} /></span
            >
            <span data-theme-icon="dark" hidden={initialThemeMode !== "dark"}
              ><Icon svg={Moon} /></span
            >
            <span
              data-theme-icon="system"
              hidden={initialThemeMode !== "system"}
              ><Icon svg={Monitor} /></span
            >
          </button>
        </div>
        {
          isAlgoliaSiteSearchConfigured && (
            <button
              type="button"
              class="search-btn"
              aria-label="Search"
              data-icon-tooltip="Search"
              data-tooltip-placement="bottom"
              data-tooltip-align="end"
              aria-controls="home-shell-search"
              aria-haspopup="dialog"
              data-home-shell-search-trigger
            >
              <Icon svg={Search} />
            </button>
          )
        }
        <details
          class="nav-drawer mobile-nav-drawer"
          data-home-shell-mobile-nav
        >
          <summary
            class="hamburger"
            aria-label="Toggle navigation"
            data-icon-tooltip="Navigation"
            data-tooltip-placement="bottom"
            data-tooltip-align="end"
          >
            <Icon svg={AlignLeft} />
          </summary>

          <nav class="wire-box nav-panel" aria-label="Mobile navigation area">
            <ul class="signature-collapse-links">
              {
                foldedNavItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-label={item.label}
                      data-astro-prefetch
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main class="home-main" data-home-shell-main>
    <section
      class="wire-box profile-area"
      aria-label="Profile area"
      data-home-entrance-content="profile"
    >
      <slot name="profile" />
    </section>

    <section
      class="wire-box latest-area"
      aria-label="Latest area"
      data-home-shell-latest
      data-home-entrance-content="latest"
    >
      <slot name="latest" />
    </section>
  </main>

  <div
    class="floating-action-stack"
    aria-label="Page controls"
    data-home-shell-fab
  >
    <FloatingActionButton
      id="toc-fab"
      label="Toggle table of contents"
      iconSvg={TableOfContents}
      className="floating-action-button--toc"
    />
    <FloatingActionButton
      id="document-progress-fab"
      label="Back to top"
      className="floating-action-button--document-progress"
    >
      <span
        class="document-progress-fab-percent"
        data-document-progress-percent
      >
        0%
      </span>
      <span
        class="document-progress-fab-icon"
        data-document-progress-icon
        hidden
      >
        <Icon svg={ArrowUp} />
      </span>
    </FloatingActionButton>
  </div>

  {
    isAlgoliaSiteSearchConfigured && (
      <div
        id="home-shell-search"
        class="home-shell-search-root"
        aria-hidden="true"
        data-home-shell-search-container
      />
    )
  }

  <footer class="home-footer">
    <div class="wire-box footer-info" aria-label="Footer info area">
      <slot name="footer-info" />
    </div>

    <nav class="wire-box footer-icons" aria-label="Footer icon navigation">
      <a
        class="footer-rss-btn"
        href="/project/"
        aria-label="View projects"
        data-icon-tooltip="Projects"
        data-astro-prefetch
      >
        <Icon svg={FolderKanban} />
      </a>
      <a
        class="footer-rss-btn"
        href="/rss.xml"
        aria-label="Subscribe via RSS"
        data-icon-tooltip="RSS Feed"
      >
        <RssIcon />
      </a>
      {
        githubHref && (
          <a
            class="footer-rss-btn"
            href={githubHref}
            target="_blank"
            rel="noreferrer"
            aria-label="Visit GitHub profile"
            data-icon-tooltip="GitHub"
          >
            <GithubIcon />
          </a>
        )
      }
      <slot name="footer-icons" />
    </nav>
  </footer>
</div>
