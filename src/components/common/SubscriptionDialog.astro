---
import { X } from "lucide-static";
import Icon from "../ui/Icon.astro";
import BarkIcon from "../ui/icons/BarkIcon.astro";
import MailIcon from "../ui/icons/MailIcon.astro";
import TelegramIcon from "../ui/icons/TelegramIcon.astro";
---

<subscription-dialog>
  <dialog id="subscription-dialog" aria-labelledby="subscription-title">
    <header>
      <h2 id="subscription-title">Subscribe</h2>
      <button type="button" data-close aria-label="Close"
        ><Icon svg={X} /></button
      >
    </header>
    <div class="channels" aria-label="Subscription channels" role="group">
      <button type="button" data-channel="bark" aria-pressed="false" disabled>
        <span class="channel-icon" aria-hidden="true"><BarkIcon /></span>
        Bark
      </button>
      <a data-telegram aria-disabled="true" target="_blank" rel="noreferrer">
        <span class="channel-icon" aria-hidden="true"><TelegramIcon /></span>
        Telegram
      </a>
      <button type="button" data-channel="email" aria-pressed="false" disabled>
        <span class="channel-icon" aria-hidden="true"><MailIcon /></span>
        Email
      </button>
    </div>
    {
      (["bark", "email"] as const).map((channel) => (
        <form data-channel-form={channel} method="post" hidden>
          <label for={`subscription-${channel}`}>
            {channel === "bark" ? "Bark device key" : "Email address"}
          </label>
          <input
            id={`subscription-${channel}`}
            name="destination"
            type={channel === "bark" ? "password" : "email"}
            autocomplete={channel === "bark" ? "off" : "email"}
            aria-describedby={
              channel === "bark" ? "subscription-bark-help" : undefined
            }
            minlength={channel === "bark" ? 10 : undefined}
            maxlength={channel === "bark" ? 128 : 254}
            required
          />
          {channel === "bark" && (
            <small id="subscription-bark-help">
              Use the device key from your api.day.app push URL.
            </small>
          )}
          <button type="submit">Send confirmation link</button>
        </form>
      ))
    }
    <p role="status" aria-live="polite"></p>
    <button type="button" data-manage hidden></button>
  </dialog>
</subscription-dialog>

<script>
  import "../../scripts/subscription-dialog";
</script>

<style>
  subscription-dialog {
    display: contents;
  }
  dialog {
    margin: auto;
    width: min(21rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 1.25rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    background: var(--paper);
    color: var(--line);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 18%);
    font-size: var(--type-sm);
    text-align: start;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 32%);
  }
  dialog [hidden] {
    display: none;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  h2 {
    margin: 0;
    font-size: var(--type-lg);
  }
  dialog :is(button, a, input) {
    font: inherit;
    color: inherit;
  }
  dialog button,
  .channels a {
    cursor: pointer;
    background: transparent;
  }
  [data-close] {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
  }
  [data-close] :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .channels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  .channels > * {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    padding: 0.25rem;
    border: 0;
    text-decoration: none;
  }
  .channel-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: var(--channel-bg, transparent);
    transform: scale(var(--channel-scale, 1));
    transform-origin: center bottom;
    transition:
      background-color 0.18s ease,
      transform 0.18s ease;
  }
  .channels :global(svg) {
    width: 1.625rem;
    height: 1.625rem;
  }
  @media (hover: hover) {
    .channels > :is(button:enabled, a[href]):hover {
      --channel-bg: var(--icon-hover-bg);
      --channel-scale: 1.12;
    }
  }
  .channels > :focus-visible {
    --channel-bg: var(--icon-hover-bg);
    --channel-scale: 1.12;
    outline: none;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .channels [aria-pressed="true"] .channel-icon {
    background-color: color-mix(in srgb, var(--line) 16%, var(--paper));
  }
  @media (prefers-reduced-motion: reduce) {
    .channel-icon {
      transition: none;
      transform: none;
    }
  }
  @media (forced-colors: active) {
    .channels [aria-pressed="true"] {
      font-weight: bold;
    }
  }
  dialog :is(:disabled, [aria-disabled="true"]) {
    opacity: 0.45;
    cursor: default;
  }
  form {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  input,
  [type="submit"],
  [data-manage] {
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.75rem;
  }
  input {
    min-width: 0;
    background: var(--paper);
  }
  small,
  [role="status"] {
    color: var(--text-muted);
  }
  [role="status"] {
    margin: 1rem 0 0;
  }
  [role="status"]:empty {
    margin: 0;
  }
  [data-manage] {
    margin-top: 0.8rem;
  }
  dialog :is(a, button, input):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
