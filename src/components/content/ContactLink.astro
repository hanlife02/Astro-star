---
import type { HTMLAttributes } from "astro/types";
import GithubIcon from "../ui/icons/GithubIcon.astro";
import MailIcon from "../ui/icons/MailIcon.astro";
import { getContactLink } from "../../utils/contact-link";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...attributes } = Astro.props;
const contact = typeof href === "string" ? getContactLink(href) : null;
---

<a
  {...attributes}
  href={href}
  class:list={[className, { "contact-link": contact }]}
>
  {
    contact ? (
      <>
        <span class="contact-link-icon" aria-hidden="true">
          {contact.kind === "github" ? <GithubIcon /> : <MailIcon />}
        </span>
        <span class="contact-link-label">{contact.label}</span>
      </>
    ) : (
      <slot />
    )
  }
</a>

<style>
  a.contact-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
    vertical-align: baseline;
  }

  .contact-link-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-self: center;
    font-size: 1.15em;
  }

  .contact-link-label {
    min-width: 0;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 28%, transparent);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.18s ease;
  }

  .contact-link:hover .contact-link-label,
  .contact-link:focus-visible .contact-link-label {
    text-decoration-color: currentColor;
  }

  .contact-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.2em;
    border-radius: 0.15em;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link-label {
      transition: none;
    }
  }
</style>
